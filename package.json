{
  "name": "why-that-goal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/core/*.test.ts server/*.test.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "evaluate:scenarios": "node --import tsx scripts/evaluate-scenarios.ts",
    "check:foundry": "node --env-file-if-exists=.env --import tsx scripts/check-foundry.ts",
    "evaluate:agents": "node --env-file-if-exists=.env --import tsx scripts/evaluate-multi-agent.ts",
    "setup:auth": "node --import tsx scripts/setup-local-auth.ts",
    "evaluate:enterprise": "node --env-file-if-exists=.env --import tsx scripts/evaluate-enterprise.ts",
    "check:load": "node --import tsx scripts/check-enterprise-load.ts",
    "publish:verification": "node --import tsx scripts/publish-verification.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@azure/msal-browser": "^5.26.0",
    "jose": "^6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
