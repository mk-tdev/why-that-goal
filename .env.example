# Server only. Use az login locally; managed identity when hosted.
FOUNDRY_ENABLED=false
FOUNDRY_RESPONSES_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
FOUNDRY_DEPLOYMENT=wtg-insights
# multi-agent (default) or single-agent (explicit comparison/rollback)
FOUNDRY_ORCHESTRATION=multi-agent

# Judges enter the replay without an account; only operator tools require login.
PUBLIC_DEMO=true
# Local access: run npm run setup:auth to generate private passwords and hashes.
AUTH_MODE=local
AUTH_OPERATOR_PASSWORD_HASH=
AUTH_VIEWER_PASSWORD_HASH=
AUTH_SESSION_SECONDS=900
# Optional private enterprise deployment: PUBLIC_DEMO=false and AUTH_MODE=entra and a single-tenant SPA/API registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=access_as_user
# Required in production: explicit frontend HTTPS origin(s), comma-separated, no wildcard.
# APP_ORIGINS=https://your-app.example

# Hosted container: runtime defaults are set in Dockerfile; keep ingress trust off locally.
# TRUST_AZURE_INGRESS=true  # ONLY behind Azure Container Apps managed ingress
# AZURE_CLIENT_ID=<user-assigned runtime managed identity client ID>
