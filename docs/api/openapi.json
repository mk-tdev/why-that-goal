                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before retrying."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          }
        },
        "description": "Measured evidence immediately; poll while trace.pending. Optional Foundry orchestration exposes trace.workflow with distinct analyst, storyteller and reviewer steps, concrete handoffs and a single writer revision. AI publication requires host checks and reviewer approval; otherwise deterministic fallback.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "description": "Required with browser session cookies; not required for valid bearer tokens.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/feed": {
      "get": {
        "operationId": "streamSyntheticSequence",
        "description": "One seeded sequence per connection, paced at 1x. SSE data frames every approximately 100 ms contain the replay clock and newly received versioned events. Final frame has complete=true; connection closes. Restart begins at zero, with no resume protocol. Foundry disconnected.",
        "parameters": [
          {
            "name": "scenarioId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "quick-break",
                "switch-play",
                "no-finish",
                "cutback-save",
                "counter-cut-out",
                "switch-intercepted"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE data: JSON with scenarioId, time (seconds), events (new MatchEvent records), complete (boolean). Events are released only after both event time and receipt time.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"scenarioId\":\"quick-break\",\"time\":0,\"events\":[],\"complete\":false}\n\n"
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "400": {
            "description": "Unknown scenario, missing/duplicate scenarioId or unexpected query parameter",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "403": {
            "description": "Origin, CSRF or operator role denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "405": {
            "description": "Method other than GET",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "429": {
            "description": "Caller rate limit or stream cap exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before retrying."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          }
        }
      }
    },
