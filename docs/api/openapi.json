              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before retrying."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "through", "receivedThrough", "audience", "language"],
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "through": {
            "type": "number",
            "minimum": 0,
            "maximum": 7200
          },
          "receivedThrough": {
            "type": "number",
            "minimum": 0,
            "maximum": 7200
          },
          "audience": {
            "type": "string",
            "enum": ["fan", "analyst"]
          },
          "language": {
            "type": "string",
            "enum": ["en", "es"]
          }
        }
      },
      "Fact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eventId",
          "version",
          "at",
          "playerId",
          "kind",
          "target",
          "text",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "at": {
            "type": "number"
          },
          "playerId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "pass-distance",
              "receiver-space",
              "pass-progress",
              "off-ball-run",
              "space-change"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "text": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": ["m"]
          },
          "fromTime": {
            "type": "number"
          },
          "toTime": {
            "type": "number"
          },
          "before": {
            "type": "number"
          },
          "after": {
            "type": "number"
          }
        }
      },
      "Moment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eventId",
          "version",
          "at",
          "playerId",
          "kind",
          "target",
          "text",
          "method",
          "replayAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "at": {
            "type": "number"
          },
          "playerId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "pass-distance",
              "receiver-space",
              "pass-progress",
              "off-ball-run",
              "space-change"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "text": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": ["m"]
          },
          "replayAt": {
            "type": "number"
          },
          "fromTime": {
            "type": "number"
          },
          "toTime": {
            "type": "number"
          },
          "before": {
            "type": "number"
          },
          "after": {
            "type": "number"
          }
        }
      },
      "EvidencePacket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "source", "request", "score", "facts", "limitations"],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": ["1.0"]
          },
          "source": {
            "type": "string",
            "enum": ["synthetic"]
          },
          "request": {
            "$ref": "#/components/schemas/AnalysisRequest"
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": ["home", "away"],
            "properties": {
              "home": {
                "type": "integer"
              },
              "away": {
                "type": "integer"
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Fact"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AnalysisResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "mode",
          "provider",
          "reason",
          "evidence",
          "moments",
          "trace",
          "buildup",
          "recap"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": ["1.0"]
          },
          "mode": {
            "type": "string",
            "enum": ["deterministic", "model-selected", "fallback"]
          },
          "provider": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "disconnected",
              "validated",
              "invalid-output",
              "provider-error",
              "timeout",
              "generating",
              "capacity",
              "collecting"
            ]
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidencePacket"
          },
          "moments": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/Moment"
            }
          },
          "trace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elapsedMs", "calls", "validated"],
            "properties": {
              "elapsedMs": {
                "type": "number"
              },
              "calls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "validated": {
                "type": "boolean"
              },
              "pending": {
                "type": "boolean"
              },
              "cacheHit": {
                "type": "boolean"
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "workflow": {
                "$ref": "#/components/schemas/WorkflowTrace"
              }
            }
          },
          "buildup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "summary", "limitation", "factIds"],
            "properties": {
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "limitation": {
                "type": "string"
              },
              "factIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "recap": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SequenceRecap"
              }
            ]
          }
        }
      },
      "Selection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factIds"],
        "properties": {
          "factIds": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SequenceRecap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "title",
          "summary",
          "through",
          "terminalFactId",
          "cards",
          "limitation"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": ["goal", "save", "failed-attack"]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "terminalFactId": {
            "type": "string"
          },
          "limitation": {
            "type": "string"
          },
          "through": {
            "type": "number"
          },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "text", "factIds"],
              "properties": {
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "factIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "AgentStep": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "enum": ["analysis", "storytelling", "evidence-check"]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "revision-requested", "rejected", "failed"]
          },
          "elapsedMs": {
            "type": "number",
            "minimum": 0
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "toolCalls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "enum": ["getFact"]
                },
                "factId": {
                  "type": "string"
                }
              },
              "required": ["name", "factId"]
            }
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "agent",
          "attempt",
          "status",
          "elapsedMs",
          "factIds",
          "summary",
          "toolCalls",
          "inputTokens",
          "outputTokens"
        ]
      },
      "AgentIssue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "unsupported-claim",
              "wrong-outcome",
              "wrong-actor",
              "missing-evidence",
              "causal-overclaim",
              "language",
              "format"
            ]
          },
          "detail": {
            "type": "string"
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["target", "reason", "detail", "factIds"]
      },
      "WorkflowTrace": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "version": {
            "type": "string",
            "enum": ["1.0"]
          },
          "status": {
            "type": "string",
            "enum": ["running", "approved", "fallback"]
          },
          "steps": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            }
          },
          "handoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "enum": ["analysis", "storytelling", "evidence-check"]
                },
                "to": {
                  "type": "string",
                  "enum": ["analysis", "storytelling", "evidence-check"]
                },
                "reason": {
                  "type": "string"
                },
                "factIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["from", "to", "reason", "factIds"]
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentIssue"
            }
          },
          "revisions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "modelCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "snapshotId",
          "version",
          "status",
          "steps",
          "handoffs",
          "issues",
          "revisions",
          "modelCalls"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "expiresAt"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["viewer", "operator"]
          },
          "csrf": {
            "type": "string",
            "description": "Keep in memory; send as X-CSRF-Token for cookie-authenticated POSTs."
          },
          "expiresAt": {
            "type": "number",
            "description": "Unix epoch milliseconds; absolute session expiry."
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Single-tenant Entra v2 delegated API token; exact audience, azp, tenant and access_as_user scope required."
      },
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wtg_session",
        "description": "HttpOnly local-development session. POSTs require X-CSRF-Token."
      },
      "SecureSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-wtg_session",
        "description": "Secure HttpOnly production session, Path=/, SameSite=Strict. POSTs require X-CSRF-Token."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "LocalSession": []
    },
    {
      "SecureSession": []
    }
  ]
}
