{
  "openapi": "3.1.0",
  "info": {
    "title": "Why That Goal local evidence API",
    "version": "1.0.0",
    "description": "Authenticated evidence API with local-development sessions or Entra delegated bearer tokens. Rate limits, CSRF, operator-only monitoring and optional Foundry multi-agent narrative generation. Factory-without-auth mode is loopback-test-only; application startup requires authentication."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8791"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "foundry"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "foundry": {
                      "type": "string",
                      "enum": ["configured", "disconnected"]
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/analyze": {
      "post": {
        "operationId": "analyze",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              },
              "example": {
                "scenarioId": "quick-break",
                "through": 19,
                "receivedThrough": 19,
                "audience": "analyst",
                "language": "en"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Time-bounded evidence with deterministic, model-generated or fallback narrative. While generation is pending, repeat the identical request after approximately 1.5 seconds. Pending responses include a deterministic recap only after the terminal event is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "400": {
            "description": "Invalid request, unknown scenario or timestamp outside duration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "403": {
            "description": "Origin, CSRF or operator role denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "413": {
            "description": "Body exceeds 8192 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated HTTP correlation ID."
              }
            }
          },
          "429": {
            "description": "Caller rate limit or stream cap exceeded",
